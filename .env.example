# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Generate a value with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQLite (default) or PostgreSQL, e.g. postgresql+psycopg://sentinel:password@localhost:5432/sentinel
DATABASE_URL=sqlite:///./data/sentinel.db

# Dashboard is served by the API at http://localhost:8000. Add origins if you host it elsewhere.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Detection ---------------------------------------------------------------
# auto = trained model if present, otherwise labelled demo heuristic
# yolo = trained model only (MODEL_NOT_AVAILABLE if missing)
# demo = colour heuristic only (fire-like regions; NOT a validated detector)
DETECTOR_MODE=auto
MODEL_WEIGHTS_PATH=ml/models/hazard_yolo.pt
INFERENCE_DEVICE=cpu
# Model class name -> hazard type (JSON). Must match your trained model's names.
# MODEL_CLASS_MAP={"fire":"FIRE","smoke":"SMOKE","accident":"ROAD_ACCIDENT","spark":"ELECTRICAL_SPARK","fall":"PERSON_FALL"}

FRAME_STRIDE=5
MAX_FRAME_WIDTH=960
DEFAULT_CONFIDENCE_THRESHOLD=0.50
# CONFIDENCE_THRESHOLDS={"SMOKE":0.60,"PERSON_FALL":0.65}
TEMPORAL_WINDOW_FRAMES=8
TEMPORAL_MIN_HITS=5
TEMPORAL_END_AFTER_MISSED=10

# --- Risk model (prototype design parameters, not measured) ---------------------
RISK_WEIGHT_CONFIDENCE=0.40
RISK_WEIGHT_PERSISTENCE=0.30
RISK_WEIGHT_SEVERITY=0.30
PERSISTENCE_SATURATION_FRAMES=15
# HAZARD_SEVERITY_FACTORS={"FIRE":0.90,"ROAD_ACCIDENT":0.85,"PERSON_FALL":0.75,"ELECTRICAL_SPARK":0.70,"SMOKE":0.60}
SEVERITY_BAND_LOW_MAX=30
SEVERITY_BAND_MEDIUM_MAX=55
SEVERITY_BAND_HIGH_MAX=75

# --- Incidents / uploads ------------------------------------------------------
INCIDENT_DEDUP_WINDOW_SECONDS=300
MAX_UPLOAD_MB=200
KEEP_UPLOADED_VIDEOS=false
MAX_CONCURRENT_JOBS=2
